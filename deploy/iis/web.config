<?xml version="1.0" encoding="UTF-8"?>
<!--
  SnipeZilla Server Manager behind IIS.

  Needs, once per machine (see INSTALL.md, "Your domain with HTTPS"):
    - IIS modules "URL Rewrite" and "Application Request Routing" (ARR).
    - IIS Manager > the server > Application Request Routing Cache > Server Proxy Settings:
        [x] Enable proxy
        Response buffer threshold (KB): 0      (else the live updates arrive in bursts)
    - szm listening on this machine only: "listen": "127.0.0.1:8888" in szm.json (Settings > Web interface address).

  Put this file in the folder of the IIS site (a subdomain such as manager.example.com) or of a sub-folder
  (example.com/szm/). Change 8888 if szm listens on another port.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- example.com/szm  ->  example.com/szm/  (the page loads its files relative to the folder) -->
        <rule name="SZM trailing slash" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{URL}" pattern="[^/]$" />
          </conditions>
          <action type="Redirect" url="{URL}/" redirectType="Permanent" />
        </rule>
        <!-- Optional: always HTTPS. Remove the comment marks once the site has a certificate.
        <rule name="SZM https" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" redirectType="Permanent" />
        </rule>
        -->
        <rule name="SZM proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8888/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Compression would hold back the live updates (Server-Sent Events) -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <security>
      <requestFiltering>
        <!-- Uploads in the file manager (maps, plugins): up to 4 GB instead of IIS's 30 MB -->
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
